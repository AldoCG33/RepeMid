{
  "expo": {
    "name": "RepeMind",
    "slug": "RepeMind",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/Icono de la app.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.aldocg.repemind",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Icono de la app.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "6c1a289a-2d31-4d26-9cc6-642b4c0b516c"
      }
    },
    "owner": "aldo33"
  }
}
